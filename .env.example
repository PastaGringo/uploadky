# Copy to .env and adjust. Every value is read at container start, so a change
# here needs only a restart — never a rebuild.

# Where uploaded files live.
UPLOADKY_HOMESERVER_HTTP_BASE=https://homeserver.pubky.app

# The public origin this service answers on, used for short share links
# (https://<that origin>/<user-key>/<file-id> redirects to the homeserver).
# Leave empty to disable short links entirely.
UPLOADKY_SHARE_BASE=

# Host port for the container. Bound to 127.0.0.1 by compose.
UPLOADKY_PORT=8080

# Optional HTTP relay for the Pubky Ring handshake.
UPLOADKY_HTTP_RELAY=

# Local testnet instead of the public network.
UPLOADKY_TESTNET=false
UPLOADKY_TESTNET_HOST=
