# Copy to .env and adjust.
#
# These are BUILD-time values: `docker compose up -d --build` after a change,
# not just a restart.

# Where uploaded files live.
VITE_HOMESERVER_HTTP_BASE=https://homeserver.pubky.app

# Optional separate short-link domain. Leave empty and the app uses its own
# origin, which is always correct — it serves the share page itself.
VITE_SHARE_BASE=

# Open Graph image path is /og.png (copied from public/ at build). og:url and
# og:image hosts are filled in at request time from the Host header, so no
# public domain is baked in.
#
# On Vercel the preview function ALSO fetches its own HTML shell, and that URL
# must not come from a header a client can forge. It uses the platform's own
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL. Set this only when running the
# function somewhere those do not exist.
UPLOADKY_PUBLIC_ORIGIN=

# Host port for the container. Bound to 127.0.0.1 by compose.
UPLOADKY_PORT=8080

# Local testnet instead of the public network.
VITE_PUBKY_TESTNET=false
VITE_PUBKY_TESTNET_HOST=
VITE_PUBKY_HTTP_RELAY=
