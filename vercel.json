{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/raw/:key/:id",
      "destination": "/api/raw"
    },
    {
      "source": "/",
      "destination": "/api/preview"
    },
    {
      "source": "/:key/:id",
      "destination": "/api/preview?key=:key&id=:id"
    },
    {
      "source": "/((?!api/|assets/|index\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
